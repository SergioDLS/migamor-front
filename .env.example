# === Masamor Frontend (Next.js) ===

# URL del proyecto Supabase (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key de Supabase (sb_publishable_...) — pública, segura en el navegador.
# Reemplaza a la legacy anon key. Settings > API Keys > Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL del backend NestJS (en local: http://localhost:3001)
NEXT_PUBLIC_API_URL=http://localhost:3001
